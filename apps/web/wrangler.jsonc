{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meal-prep-agent",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meal-prep-local",
      "database_id": "00000000-0000-0000-0000-000000000007",
      "migrations_dir": "../../deploy/migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1431701",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "1431702",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1431703",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
